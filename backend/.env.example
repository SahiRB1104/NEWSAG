# Server and browser access
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
LOG_LEVEL=INFO
# Leave blank in Cloud Run to use stdout only; use logs/app.log for local files.
LOG_FILE=

# Required persistence and caching services
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# GNews
GNEWS_API_KEY=replace_with_gnews_api_key
CACHE_TTL_NEWS_TOPIC=432000
GNEWS_REFRESH_INTERVAL_SEC=900

# Clerk authentication and admin access
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_AUDIENCE=
CLERK_API_KEY=replace_with_clerk_secret_key
CLERK_API_BASE=https://api.clerk.com/v1
CLERK_COUNT_CACHE_TTL=30
ADMIN_USER_IDS=
CLERK_ADMIN_METADATA_KEY=admin
CLERK_ADMIN_ORG_ROLES=admin,owner
JWKS_FAILURE_COOLDOWN_SECONDS=30

# Optional external Ollama service. Cloud Run must use a reachable URL; it does
# not run an Ollama daemon inside this image. The app falls back when unavailable.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=90

# Optional Amazon Polly TTS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Legacy variable retained because it exists in the current local environment;
# no current backend code reads it.
NEWS_API_KEY=
